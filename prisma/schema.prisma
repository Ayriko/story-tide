generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RelationOrigin {
  MANUAL
  AUTO
}

// Origine du monde (KAN-18) : USER = cree normalement par un utilisateur,
// compte pour le quota freemium. INTRO = monde d'introduction "Atheraus",
// clone a l'inscription (KAN-35, pas encore construit). DEMO = monde du
// compte de demonstration jury, distinct du monde d'intro par utilisateur.
// INTRO et DEMO sont hors quota freemium sur les DEUX axes (mondes ET
// entites - voir world-service.ts/entity-service.ts).
enum WorldOrigin {
  USER
  INTRO
  DEMO
}

// Origine d'un alias (KAN-18) : MANUAL = saisi par un utilisateur via le
// formulaire de fiche. SEED = cree par un script de seed (KAN-35, pas encore
// construit) - reserve, aucune logique n'en depend encore.
enum AliasSource {
  MANUAL
  SEED
}

// Role et plan utilisateur (KAN-72, ADR-0029). Deux axes distincts, jamais
// fusionnes : le role dit ce qu'on peut administrer (/admin), le plan dit ce
// qu'on peut creer (quotas, src/lib/quotas.ts).
enum UserRole {
  USER
  ADMIN
}

enum UserPlan {
  FREE
  UNLIMITED
}

// Origine du plan : DEFAULT = valeur d'inscription, MANUAL = pose par un
// administrateur (prioritaire sur un futur abonnement, qui ne doit jamais
// ecraser un compte offert), SUBSCRIPTION = reserve a l'abonnement a venir.
enum PlanSource {
  DEFAULT
  MANUAL
  SUBSCRIPTION
}

model World {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String
  ownerId                   String
  owner                     User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  origin                    WorldOrigin                @default(USER)
  // Epinglage (quick win 2.5) : proprietaire unique par monde pour le moment
  // (hypothese assumee, cf. commentaire de pinWorld/unpinWorld dans
  // world-service.ts) - nullable, colonne seule dans sa migration, jamais
  // fusionnee avec celle de KAN-38.
  pinnedAt                  DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  entities                  Entity[]
  relations                 Relation[]
  linkIgnores               LinkIgnore[]
  images                    Image[]
  folders                   Folder[]
  // Parametrage des types (KAN-81, ADR-0030) : cles NATIVES (ENTITY_TYPES)
  // non proposees a la creation dans ce monde. Les entrees existantes de ces
  // types les gardent et les affichent.
  hiddenEntityTypes         String[]                   @default([])
  customEntityTypes         CustomEntityType[]
  // Meme parametrage pour les types de relation (KAN-84, ADR-0031) : cles
  // NATIVES (RELATION_TYPES) non proposees dans ce monde.
  hiddenRelationTypes       String[]                   @default([])
  customRelationTypes       CustomRelationType[]
  declaredRelations         DeclaredRelation[]
  relationSuggestionIgnores RelationSuggestionIgnore[]
  // Disposition de la Constellation (KAN-87, ADR-0032).
  boards                    Board[]

  @@unique([ownerId, slug])
  @@index([ownerId])
}

model Entity {
  id             String            @id @default(cuid())
  worldId        String
  world          World             @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name           String
  type           String // "character"|"place"|... - donnee, pas schema
  content        Json // JSON ProseMirror (Tiptap)
  plainText      String // texte extrait, pour scan + recherche
  // Cle d'idempotence de seed (KAN-35, pas encore construit) : distincte du
  // slug (modifiable par l'utilisateur apres clonage) - permet au script de
  // seed de savoir si une entite a deja ete creee lors d'un rejeu.
  seedRef        String?
  // Rattachement FACULTATIF a un dossier (KAN-38) : nullable, jamais un
  // second encodage du type - folderId est une position dans un arbre,
  // "type" reste une donnee (pas d'enum Prisma dessus, invariant du projet).
  // onDelete: SetNull (jamais Cascade) - supprimer un dossier ne supprime
  // jamais une entite, seulement sa position (voir folder-service.ts).
  folderId       String?
  folder         Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  // Signal de fin de scan (KAN-77) : contentVersion incremente a chaque
  // sauvegarde de contenu, scannedVersion = version lue par le dernier job de
  // liaison termine. scannedVersion >= contentVersion => "Renvois" a jour.
  contentVersion Int               @default(0)
  scannedVersion Int               @default(0)
  // Type personnalise du monde (KAN-81, ADR-0030) : renseigne si et seulement
  // si type = "custom" (contrainte CHECK posee en SQL dans la migration,
  // Prisma ne sait pas la declarer). onDelete: NoAction et PAS Restrict :
  // RESTRICT est verifie immediatement et ferait echouer la suppression d'un
  // monde (cascade World -> Entity et World -> CustomEntityType dans la meme
  // instruction) ; NO ACTION est verifie en fin d'instruction - supprimer un
  // monde passe, supprimer directement un type encore utilise echoue.
  customTypeId   String?
  customType     CustomEntityType? @relation(fields: [customTypeId], references: [id], onDelete: NoAction)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  aliases               Alias[]
  sourceRelations       Relation[]                 @relation("RelationSource")
  targetRelations       Relation[]                 @relation("RelationTarget")
  linkIgnoresFrom       LinkIgnore[]               @relation("LinkIgnoreEntity")
  linkIgnoresTo         LinkIgnore[]               @relation("LinkIgnoreTarget")
  // Relations declarees (KAN-84, ADR-0031) - distinctes des reflets du texte
  // ci-dessus, jamais touchees par la reconciliation ni par le worker.
  declaredAsSource      DeclaredRelation[]         @relation("DeclaredSource")
  declaredAsTarget      DeclaredRelation[]         @relation("DeclaredTarget")
  suggestionIgnoresFrom RelationSuggestionIgnore[] @relation("SuggestionIgnoreEntity")
  suggestionIgnoresTo   RelationSuggestionIgnore[] @relation("SuggestionIgnoreTarget")
  // Position de l'etoile sur les tableaux du monde (KAN-87, ADR-0032).
  boardNodes            BoardNode[]

  @@unique([worldId, seedRef])
  @@index([worldId])
  @@index([folderId])
  @@index([customTypeId])
}

// Type d'entree propre a un monde (KAN-81, ADR-0030). Le registre natif
// (26 types) reste en code (entity-schemas.ts) ; une entree d'un type perso
// porte type = "custom" + customTypeId.
model CustomEntityType {
  id        String   @id @default(cuid())
  worldId   String
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  label     String // NFC (ADR-0020), 1 a 40 caracteres
  // normalizeForMatch(label) : cle de comparaison insensible a la casse et aux
  // accents - porte l'unicite du libelle dans le monde (pas d'index sur
  // expression : unaccent n'est pas IMMUTABLE). La collision avec les 26
  // libelles natifs est verifiee dans le service.
  labelKey  String
  group     String // une des 8 cles de ENTITY_TYPE_GROUPS, validee par Zod (pas d'enum, comme Entity.type)
  icon      String // cle de CUSTOM_TYPE_ICONS ; inconnue -> icone du groupe
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entities  Entity[]

  @@unique([worldId, labelKey])
  @@index([worldId])
}

// Organisation FACULTATIVE des entites d'un monde (KAN-38), en arborescence.
// Coexiste avec le regroupement existant par type d'entite sans le
// remplacer : ce fichier n'est jamais importe par entity-service.ts ni par
// entity-schemas.ts, et reciproquement - deux regroupements independants,
// ni l'un ni l'autre parent de l'autre.
model Folder {
  id        String   @id @default(cuid())
  worldId   String
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  // Auto-relation onDelete: Cascade - un dossier est de la STRUCTURE, pas du
  // contenu utilisateur : le supprimer supprime ses sous-dossiers en
  // cascade. Compose avec Entity.folder (SetNull, ci-dessus) via Postgres :
  // les deux actions FK natives s'appliquent dans la meme instruction
  // DELETE, quelle que soit la ligne Folder a l'origine (directe ou
  // cascadee) - voir le raisonnement complet dans folder-service.ts.
  parent    Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderChildren")
  entities  Entity[]
  // Cle d'idempotence de seed (meme convention qu'Entity.seedRef) - reservee
  // pour un futur createSeedFolder, aucun seed de dossier livre par KAN-38.
  seedRef   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([worldId, seedRef])
  @@index([worldId])
  @@index([parentId])
}

// Table dediee (KAN-18, remplace Entity.aliases String[]) : attributs propres
// (actif/inactif, source) et index sur la forme normalisee pour le
// chargement du dictionnaire Aho-Corasick (linker-service.ts).
model Alias {
  id         String      @id @default(cuid())
  entityId   String
  entity     Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  value      String
  normalized String // sortie de normalizeForMatch(value) - jamais recalculee ailleurs
  active     Boolean     @default(true)
  source     AliasSource @default(MANUAL)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([entityId, value])
  @@index([normalized])
}

model Relation {
  id        String         @id @default(cuid())
  worldId   String
  world     World          @relation(fields: [worldId], references: [id], onDelete: Cascade)
  sourceId  String
  source    Entity         @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    Entity         @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  origin    RelationOrigin
  createdAt DateTime       @default(now())

  @@unique([sourceId, targetId, origin])
  @@index([worldId])
  @@index([targetId])
}

model LinkIgnore {
  id        String   @id @default(cuid())
  worldId   String
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  entityId  String
  entity    Entity   @relation("LinkIgnoreEntity", fields: [entityId], references: [id], onDelete: Cascade)
  targetId  String
  target    Entity   @relation("LinkIgnoreTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([entityId, targetId])
  @@index([worldId])
}

// Type de relation propre a un monde (KAN-84, ADR-0031, patron ADR-0030). Le
// registre natif (14 types) reste en code (relation-types.ts) ; une relation
// d'un type perso porte relationType = "custom" + customRelationTypeId.
model CustomRelationType {
  id           String             @id @default(cuid())
  worldId      String
  world        World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  label        String // NFC (ADR-0020), 1 a 40 caracteres, ex. « Suzerain de »
  // normalizeForMatch(label) : porte l'unicite du libelle dans le monde (meme
  // raison que CustomEntityType.labelKey). Les collisions avec les libelles et
  // inverses natifs, et avec les inverses perso, sont verifiees dans le service.
  labelKey     String
  // Requis si dirige, interdit si symetrique (Zod + CHECK SQL dans la migration).
  inverseLabel String?
  symmetric    Boolean
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  relations    DeclaredRelation[]

  @@unique([worldId, labelKey])
  @@index([worldId])
}

// Relation DECLAREE par l'auteur (KAN-84, ADR-0031), distincte de Relation
// (AUTO/MANUAL = reflets du texte) : elle survit a toute sauvegarde de texte.
// Une relation symetrique est stockee une seule fois, (source, cible) ordonnes
// par id, pour que A<->B et B<->A tombent sur le meme index unique.
model DeclaredRelation {
  id                   String              @id @default(cuid())
  worldId              String
  world                World               @relation(fields: [worldId], references: [id], onDelete: Cascade)
  sourceId             String
  source               Entity              @relation("DeclaredSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId             String
  target               Entity              @relation("DeclaredTarget", fields: [targetId], references: [id], onDelete: Cascade)
  relationType         String // cle native (RELATION_TYPES) ou "custom" - donnee, pas d'enum
  // Renseigne si et seulement si relationType = "custom" (CHECK SQL).
  // onDelete: NoAction et PAS Restrict - meme raisonnement que
  // Entity.customTypeId (KAN-81) : la cascade d'une suppression de monde passe,
  // la suppression directe d'un type encore utilise echoue.
  customRelationTypeId String?
  customRelationType   CustomRelationType? @relation(fields: [customRelationTypeId], references: [id], onDelete: NoAction)
  // Cle native ou `custom:<id>` : porte l'unicite (un index unique avec une
  // colonne NULL ne bloquerait pas les doublons natifs). Coherence avec les
  // deux colonnes ci-dessus garantie par un CHECK SQL.
  typeKey              String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([sourceId, targetId, typeKey])
  @@index([worldId])
  @@index([targetId])
  @@index([customRelationTypeId])
}

// Suggestion de relation ecartee par l'auteur sur une fiche (KAN-84) : la
// cible citee n'est plus proposee comme relation. Patron de LinkIgnore, sans
// effet sur les liens du texte.
model RelationSuggestionIgnore {
  id        String   @id @default(cuid())
  worldId   String
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  entityId  String
  entity    Entity   @relation("SuggestionIgnoreEntity", fields: [entityId], references: [id], onDelete: Cascade)
  targetId  String
  target    Entity   @relation("SuggestionIgnoreTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([entityId, targetId])
  @@index([worldId])
}

// Metadonnees d'une image uploadee depuis l'editeur (KAN-16) : la base ne
// stocke que la reference + les metadonnees, le binaire vit dans MinIO
// (`key`, port Storage). Scope = le MONDE (pas la fiche) : une image
// appartient a un monde, reutilisable par n'importe quelle fiche de ce
// monde - meme frontiere d'autorisation que les autres modeles worldId.
model Image {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  key         String   @unique
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  @@index([worldId])
}

model User {
  id            String          @id
  name          String
  email         String
  emailVerified Boolean         @default(false)
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessions      Session[]
  accounts      Account[]
  worlds        World[]
  // KAN-72 : colonnes a DEFAULT, hors du perimetre de Better Auth (aucun
  // additionalFields dans auth.ts) - le role se relit en base a chaque appel,
  // jamais depuis la session.
  role          UserRole        @default(USER)
  plan          UserPlan        @default(FREE)
  planSource    PlanSource      @default(DEFAULT)
  adminActions  AdminAuditLog[] @relation("AdminActor")
  adminHistory  AdminAuditLog[] @relation("AdminTarget")

  @@unique([email])
  @@map("user")
}

// Journal des actions d'administration (KAN-72, ADR-0029) : qui a change quoi
// sur quel compte, quand, pourquoi. Ecrit dans la meme transaction que le
// changement qu'il trace. actor sans onDelete (RESTRICT) : un compte qui a
// agi comme administrateur ne se supprime pas tant que ses lignes existent.
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String
  actor        User     @relation("AdminActor", fields: [actorId], references: [id])
  targetUserId String
  target       User     @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  // "plan.change" | "role.change" (constantes TS, pas d'enum SQL : la liste va grandir)
  action       String
  before       Json
  after        Json
  reason       String
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Disposition de la Constellation (KAN-87, ADR-0032) : un tableau par monde
// pour le moment (le tableau par defaut, cree a la demande - plusieurs
// tableaux = lot D). Un seul tableau par defaut par monde : index unique
// PARTIEL pose en SQL dans la migration (Prisma ne le declare pas). Cadrage
// tout null (jamais cadre : ajuster a l'ecran) ou tout renseigne avec
// zoom > 0 : CHECK SQL.
model Board {
  id        String      @id @default(cuid())
  worldId   String
  world     World       @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name      String // « Constellation » pour le tableau par defaut
  isDefault Boolean     @default(false)
  zoom      Float?
  panX      Float?
  panY      Float?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  nodes     BoardNode[]

  @@index([worldId])
}

// Position d'une entree sur un tableau. L'entree et le tableau appartiennent
// au meme monde : verifie dans board-service.ts (pas de FK composite).
model BoardNode {
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  x         Float
  y         Float
  updatedAt DateTime @updatedAt

  @@id([boardId, entityId])
  @@index([entityId])
}
