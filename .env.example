# Environnement
NODE_ENV=development

# Base de donnees (PostgreSQL — docker-compose.dev.yml)
DATABASE_URL="postgresql://story_tide:story_tide@localhost:5432/story_tide?schema=public"

# Authentification (Better Auth)
# BETTER_AUTH_SECRET est un secret a GENERER (ex. `openssl rand -base64 32`),
# jamais recupere. Valeur ci-dessous = placeholder dev uniquement ;
# en staging/prod, generer une valeur forte et ne jamais la committer.
BETTER_AUTH_SECRET="change-me-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# Stockage binaires (MinIO — docker-compose.dev.yml)
S3_ENDPOINT="localhost"
S3_PORT=9000
S3_USE_SSL=false
# S3_REGION est exigee par le SDK S3 (signature AWS SigV4), meme si MinIO ne
# route rien selon la region en mono-nœud : valeur arbitraire en dev, mais
# redevient significative en staging/prod avec OVH Object Storage (ex. "gra", "sbg").
S3_REGION="us-east-1"
# S3_ACCESS_KEY / S3_SECRET_KEY doivent correspondre a MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD dans docker-compose.dev.yml. Placeholder en dev ; a
# generer en staging/prod (idealement une cle dediee a droits restreints,
# pas le compte root MinIO — moindre privilege).
S3_ACCESS_KEY="story_tide"
S3_SECRET_KEY="change-me-story-tide"
S3_BUCKET="story-tide-dev"

# Envoi de messages (KAN-52 — reinitialisation de mot de passe)
# SMTP OVH : ssl0.ovh.net, port 465 avec SMTP_SECURE=true (TLS immediat) ou
# 587 avec false (STARTTLS).
#
# ATTENTION — le compte authentifie n'est PAS l'expediteur affiche :
#   SMTP_USER = admin@storytide.fr  (boite reelle, la seule qui peut
#               s'authentifier ; c'est elle qui porte un mot de passe)
#   MAIL_FROM = contact@storytide.fr (adresse publique du produit, alias sans
#               boite : elle ne peut donc pas servir a s'authentifier)
# Ne pas "corriger" SMTP_USER en contact@ : l'alias n'a pas de mot de passe et
# le serveur repond `535 5.7.1 Authentication failed` (constate le 2026-08-17).
# Montage valide le 2026-08-13 via le « Envoyer en tant que » de Gmail, qui
# utilise exactement les memes reglages.
#
# SMTP_PASSWORD est un secret : la valeur ci-dessous est un PLACEHOLDER, la
# vraie valeur ne doit exister que dans .env (ignore par git) en dev et dans
# deploy/.env.staging / deploy/.env.prod sur le VPS — jamais dans le depot.
SMTP_HOST="ssl0.ovh.net"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="admin@storytide.fr"
SMTP_PASSWORD="change-me-smtp-password"
# Expediteur affiche aux utilisateurs. Peut differer de SMTP_USER (voir
# ci-dessus), a condition que le serveur autorise ce couple.
MAIL_FROM="Story Tide <contact@storytide.fr>"
# "smtp" (defaut) envoie reellement ; "memory" n'envoie rien et sert aux runs
# e2e (.env.e2e). Ne jamais poser "memory" en staging/prod : les utilisateurs
# ne recevraient plus rien, sans la moindre erreur visible.
MAIL_TRANSPORT=smtp